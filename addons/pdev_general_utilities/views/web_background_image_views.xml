<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Tree view -->
		<record id="web_background_image_view_tree" model="ir.ui.view">
			<field name="name">web.background.image.view.tree</field>
			<field name="model">web.background.image</field>
			<field name="arch" type="xml">
				<list string="Background images">
					<field name="name"/>
				</list>
			</field>
		</record>
		<!-- Form view -->
		<record id="web_background_image_view_form" model="ir.ui.view">
			<field name="name">web.background.image.view.form</field>
			<field name="model">web.background.image</field>
			<field name="arch" type="xml">
				<form string="Image">
					<sheet>
						<group>
							<field widget="binary" height="64" name="image" filename="name" />
							<field name="name" invisible="1" readonly="1" force_save="1"/>
						</group>
					</sheet>
				</form>
			</field>
		</record>
	</data>
</odoo>
