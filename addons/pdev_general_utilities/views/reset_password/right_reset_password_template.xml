<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="right_reset_password_layout" name="Right Reset Password Layout">
        <t t-call="web.frontend_layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="body_classname" t-value="'bg-100'"/>
            <t t-set="no_header" t-value="True"/>
            <t t-set="no_footer" t-value="True"/>
            <div class="custom-oauth-background custom-oauth-layout-right" id="background"
                t-attf-style="background-image: linear-gradient(
                    rgba(#{gradient_top_r}, #{gradient_top_g}, #{gradient_top_b}, #{gradient_top_opacity}%),
                    rgba(#{gradient_bottom_r}, #{gradient_bottom_g}, #{gradient_bottom_b}, #{gradient_bottom_opacity}%)
                ), url('#{background_src}'); background-color: #{background_color};">
                <div t-if="video!=''"
                    style="pointer-events: none; position: fixed; top: 0; right: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden;">
                    <iframe
                        t-attf-src="https://www.youtube.com/embed/#{video}?autoplay=1&amp;mute=1&amp;loop=1&amp;controls=0&amp;showinfo=0&amp;disablekb=1&amp;modestbranding=1&amp;rel=0&amp;playlist=#{video}"
                        title="YouTube video player" frameborder="0" allow="autoplay"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen=""
                        style="width: 177.78vh; height: 100vh; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"/>
                </div>
                <div class="container body_login" t-attf-style="opacity: #{credential_opacity}">
                    <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list"
                        id="mcard"
                        t-attf-style="background-color: #{credential_border} !important; float: right">
                        <div class="card-body">
                            <div>
                                <div t-attf-class="text-center pb-3 border-bottom {{'mb-3' if form_small else 'mb-4'}}">
                                    <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                                        alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
                                </div>
                                <t t-raw="0"/>
                                <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                                    <t t-if="not disable_database_manager">
                                        <a class="border-right pr-2 mr-1" href="/web/database/manager">Manage Databases</a>
                                    </t>
                                    <a href="https://pachedev.com?utm_source=pdev_general_utilities&amp;utm_medium=auth"
                                        target="_blank">Powered by <span class="powered-by-pdev">Pachedev</span></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <template id="right_reset_password_template" name="Right Reset Password">
        <t t-call="pdev_general_utilities.right_reset_password_layout">
            <div t-if="message" class="oe_login_form clearfix">
                <div class="form-alerts">
                    <p class="alert alert-success" t-if="message" role="status"><t t-esc="message"/></p>
                </div>
                <a href="/web/login" class="btn btn-link btn-sm float-start" role="button">Back to Login</a>
            </div>
            <form class="oe_reset_password_form" role="form" method="post" t-if="not message">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <t t-if="token and not invalid_token">
                    <t t-set="only_passwords" t-value="1"/>
                    <div class="form-group field-login effect">
                        <input type="text" placeholder="Your Email" name="login" t-att-value="login"
                            id="login" class="form-control form-control-sm" autofocus="autofocus"
                            autocapitalize="off" required="required"
                            t-att-readonly="'readonly' if only_passwords else None"
                            t-attf-style="border-bottom: 1px solid #{credential_element_color} !important;"/>
                    </div>
                    <div class="form-group field-login effect">
                        <input type="text" placeholder="Your Name" name="name" t-att-value="name"
                            id="name" class="form-control form-control-sm" required="required"
                            t-att-readonly="'readonly' if only_passwords else None"
                            t-att-autofocus="'autofocus' if login and not only_passwords else None"
                            t-attf-style="border-bottom: 1px solid #{credential_element_color} !important;"/>
                    </div>
                    <div class="form-group field-password effect input-group effect o_caps_lock_warning">
                        <input type="password" placeholder="Password" name="password" id="password"
                            t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                            required="required"
                            t-att-autofocus="'autofocus' if only_passwords else None" maxlength="4096"
                            t-attf-style="border-bottom: 1px solid #{credential_element_color} !important;"/>
                        <button type="button" class="btn btn-sm border border-start-0 o_show_password">
                            <i class="fa fa-eye"/>
                        </button>
                    </div>
                    <div class="form-group field-password effect input-group effect o_caps_lock_warning">
                        <input type="password" placeholder="Confirm Password" name="confirm_password"
                            id="confirm_password"
                            t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                            required="required" maxlength="4096"
                            t-attf-style="border-bottom: 1px solid #{credential_element_color} !important;"/>
                        <button type="button" class="btn btn-sm border border-start-0 o_show_password">
                            <i class="fa fa-eye"/>
                        </button>
                    </div>
                </t>

                <t t-if="not token">
                    <div class="form-group field-login effect">
                        <input type="text" placeholder="Email" name="login" t-att-value="login"
                            id="login" class="form-control" autofocus="autofocus"
                            required="required" autocapitalize="off"
                            t-attf-style="border-bottom: 1px solid #{credential_element_color} !important;"/>
                    </div>
                </t>

                <div class="form-alerts">
                    <p class="alert alert-danger" t-if="error" role="alert"><t t-esc="error"/></p>
                    <p class="alert alert-success" t-if="message" role="status"><t t-esc="message"/></p>
                </div>

                <input type="hidden" name="redirect" t-att-value="redirect"/>
                <input type="hidden" name="token" t-att-value="token"/>

                <div t-attf-class="clearfix oe_login_buttons text-center mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                    <button type="submit" class="btn btn-primary btn-block">Reset Password</button>
                    <div class="mt-3 d-flex flex-column justify-content-center gap-1 small">
                        <a t-if="not token" t-attf-href="/web/login?{{ keep_query() }}">Back to Login</a>
                        <a t-if="invalid_token" href="/web/login">Back to Login</a>
                    </div>
                    <div t-if="not is_oauth_installed" class="o_login_auth"/>
                    <div t-if="is_oauth_installed" class="o_login_auth">
                        <t t-call="auth_oauth.providers"/>
                    </div>
                </div>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
            </form>
        </t>
    </template>
</odoo>
