<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="middle_login_layout" name="Middle Login Layout">
        <t t-call="web.layout">
            <t t-set="html_data" t-value="{'style': 'height: 100%;'}"/>
            <t t-set="head">
                <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no"/>
                <t t-call-assets="web.assets_common" t-js="false"/>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
                <t t-call-assets="web.assets_common" t-css="false"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </t>
            <t t-set="body_classname" t-value="'bg-100'"/>
            <div class="custom-oauth-background custom-oauth-layout-middle" id="background"
                t-attf-style="background-image: linear-gradient(
                    rgba(#{gradient_top_r}, #{gradient_top_g}, #{gradient_top_b}, #{gradient_top_opacity}%),
                    rgba(#{gradient_bottom_r}, #{gradient_bottom_g}, #{gradient_bottom_b}, #{gradient_bottom_opacity}%)
                ), url('#{background_src}'); background-color: #{background_color};">
                <div t-if="video!=''"
                    style="pointer-events: none; position: fixed; top: 0; right: 0; width: 100%; height: 100%; z-index: -1; overflow: hidden;">
                    <iframe
                        t-attf-src="https://www.youtube.com/embed/#{video}?autoplay=1&amp;mute=1&amp;loop=1&amp;controls=0&amp;showinfo=0&amp;disablekb=1&amp;modestbranding=1&amp;rel=0&amp;playlist=#{video}"
                        title="YouTube video player" frameborder="0" allow="autoplay"
                        referrerpolicy="strict-origin-when-cross-origin" allowfullscreen=""
                        style="width: 177.78vh; height: 100vh; position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);"/>
                </div>
                <div class="container body_login" t-attf-style="opacity: #{credential_opacity}">
                    <div t-attf-class="card border-0 mx-auto bg-100 {{login_card_classes}} o_database_list"
                        id="mcard" t-attf-style="background-color: #{credential_border} !important">
                        <div class="card-body">
                            <div>
                                <div t-attf-class="text-center pb-3 border-bottom {{'mb-3' if form_small else 'mb-4'}}">
                                    <img t-attf-src="/web/binary/company_logo{{ '?dbname='+db if db else '' }}"
                                        alt="Logo" style="max-height:120px; max-width: 100%; width:auto"/>
                                </div>
                                <t t-raw="0"/>
                                <div class="text-center small mt-4 pt-3 border-top" t-if="not disable_footer">
                                    <t t-if="not disable_database_manager">
                                        <a class="border-right pr-2 mr-1" href="/web/database/manager">Manage Databases</a>
                                    </t>
                                    <a href="https://pachedev.com?utm_source=pdev_general_utilities&amp;utm_medium=auth"
                                        target="_blank">Powered by <span class="powered-by-pdev">Pachedev</span></a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Toggle mostrar/ocultar contraseña. Script inline porque este layout
                 usa web.layout y NO arranca el framework de interacciones de Odoo
                 (la interacción nativa web.show_password nunca corre). La CSP del
                 login solo limita frame-ancestors, no script-src, así que el inline
                 se ejecuta. Delegación en document → cubre el botón .o_show_password. -->
            <script type="text/javascript">
                document.addEventListener("click", function (ev) {
                    var button = ev.target.closest(".o_show_password");
                    if (!button) { return; }
                    var group = button.closest(".input-group");
                    var input = group &amp;&amp; group.querySelector("input[type='password'], input[type='text']");
                    if (!input) { return; }
                    var show = input.getAttribute("type") === "password";
                    input.setAttribute("type", show ? "text" : "password");
                    var icon = button.querySelector("i");
                    if (icon) {
                        icon.classList.toggle("fa-eye", !show);
                        icon.classList.toggle("fa-eye-slash", show);
                    }
                });
            </script>
        </t>
    </template>

    <template id="middle_login_template" name="Middle Login">
        <t t-call="pdev_general_utilities.middle_login_layout">
            <owl-component t-if="not login" name="web.user_switch"/>
            <form class="oe_login_form" role="form" t-attf-action="/web/login" method="post"
                onsubmit="this.action = '/web/login' + location.hash">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                <div class="form-group field-db" t-if="databases and len(databases) &gt; 1">
                    <div t-attf-class="input-group {{'input-group-sm' if form_small else ''}}">
                        <input type="text" name="db" t-att-value="request.db" id="db"
                            t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                            required="required" readonly="readonly"/>
                        <span class="input-group-append">
                            <a role="button" href="/web/database/selector" class="btn btn-secondary">
                                Select <i class="fa fa-database" role="img" aria-label="Database" title="Database"/>
                            </a>
                        </span>
                    </div>
                </div>

                <div class="form-group field-login effect">
                    <input type="text" placeholder="Enter your email" name="login"
                        t-att-value="login" id="login"
                        t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                        required="required" autofocus="autofocus" autocapitalize="off"
                        autocomplete="username"
                        t-attf-style="border-bottom: 1px solid #{credential_element_color} !important;"/>
                </div>

                <div class="form-group input-group field-password effect o_caps_lock_warning">
                    <input type="password" placeholder="Enter your password" name="password"
                        id="password"
                        t-attf-class="form-control #{'form-control-sm' if form_small else ''}"
                        required="required" autocomplete="current-password"
                        t-att-autofocus="'autofocus' if login else None" maxlength="4096"
                        t-attf-style="border-bottom: 1px solid #{credential_element_color} !important;"/>
                    <button type="button" class="btn btn-sm border border-start-0 o_show_password">
                        <i class="fa fa-eye"/>
                    </button>
                </div>

                <p class="alert alert-danger" t-if="error" role="alert"><t t-esc="error"/></p>
                <p class="alert alert-success" t-if="message" role="status"><t t-esc="message"/></p>

                <div t-attf-class="clearfix oe_login_buttons text-center mb-1 {{'pt-2' if form_small else 'pt-3'}}">
                    <button type="submit" class="btn btn-primary btn-block"
                        t-attf-style="background-color: #{credential_element_color} !important; border-color: #{credential_element_color} !important; width: 100%;">Log in</button>
                    <t t-if="debug">
                        <br/>
                        <button type="submit" name="redirect" value="/web/become"
                            class="btn btn-link btn-sm btn-block">Log in as superuser</button>
                    </t>
                    <div class="mt-3 d-flex flex-column justify-content-center gap-1 small">
                        <a t-if="signup_enabled" t-attf-href="/web/signup?{{ keep_query() }}">Don't have an account?</a>
                        <a t-if="reset_password_enabled" t-attf-href="/web/reset_password?{{ keep_query() }}">Reset Password</a>
                    </div>
                    <t t-call="web.login_oauth"/>
                </div>

                <input type="hidden" name="type" value="password"/>
                <input type="hidden" name="redirect" t-att-value="redirect"/>
            </form>
            <div class="oe_structure" id="oe_structure_login_bottom"/>
        </t>
    </template>

    <template id="modify_passkey_login_oauth" inherit_id="auth_passkey.auth_passkey_login_oauth">
        <xpath expr="//t[@t-set='passkey_btn']" position="attributes">
            <attribute name="t-value">[{'css_class': 'fa fa-qrcode', 'body': passkey_body, 'list_item_class': 'passkey_login_link'}] if not disable_passkey else []</attribute>
        </xpath>
    </template>
</odoo>
