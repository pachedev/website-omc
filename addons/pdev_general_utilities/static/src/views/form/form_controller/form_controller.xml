<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
	<t t-name="pdev_general_utilities.FormView" t-inherit="web.FormView" t-inherit-mode="extension" owl="1">
		<xpath expr="//button[hasclass('o_form_button_create')]" position="attributes">
			<attribute name="class">btn btn-outline-primary o_form_button_create py-1</attribute>
		</xpath>
	</t>

	<t t-name="pdev_general_utilities.web.FormView.Buttons" t-inherit="web.FormView.Buttons" t-inherit-mode="extension" owl="1">
		<xpath expr="//button[hasclass('o_form_button_create')]" position="attributes">
			<attribute name="class">btn btn-secondary o_form_button_create py-1</attribute>
		</xpath>
	</t>
</templates>