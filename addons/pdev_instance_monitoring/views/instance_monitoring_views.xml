<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_instance_monitoring_form" model="ir.ui.view">
        <field name="name">pdev.instance.monitoring.form</field>
        <field name="model">pdev.instance.monitoring</field>
        <field name="arch" type="xml">
            <form string="Monitoreo de la instancia" create="0" delete="0" duplicate="0">
                <header>
                    <button name="action_regenerate_api_key" type="object"
                            string="Regenerar API Key" class="btn-primary"
                            confirm="¿Regenerar la API Key? El monitor configurado dejará de funcionar hasta actualizar la clave."
                            groups="pdev_instance_monitoring.group_pdev_instance_monitoring_manager"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <label for="instance_uuid"/>
                        <div class="d-flex align-items-center gap-2">
                            <field name="instance_uuid" password="True" class="flex-grow-1"/>
                            <field name="instance_uuid" widget="CopyClipboardButton" nolabel="1"/>
                        </div>
                        <label for="api_key"/>
                        <div class="d-flex align-items-center gap-2">
                            <field name="api_key" password="True" class="flex-grow-1"/>
                            <field name="api_key" widget="CopyClipboardButton" nolabel="1"/>
                        </div>
                        <field name="active" invisible="1"/>
                    </group>
                    <group string="Endpoint de monitoreo" groups="base.group_system">
                        <div colspan="2">
                            <p>Método: <code>GET</code> o <code>POST</code></p>
                            <p>Ruta: <code>/pdev/instance/monitoring</code></p>
                            <p>Autenticación: encabezado <code>X-API-KEY</code>, parámetro
                               <code>api_key</code> o cuerpo JSON <code>{"api_key": "..."}</code>.</p>
                            <p>Respuesta: <code>200</code> con la información del servidor si la
                               clave es válida; <code>401</code> en caso contrario.</p>
                        </div>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
