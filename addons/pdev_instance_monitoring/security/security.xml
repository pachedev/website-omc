<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Categoría de aplicación (agrupa el privilegio en Ajustes > Usuarios) -->
    <record id="module_category_pdev_monitoring" model="ir.module.category">
        <field name="name">Monitoreo de instancia</field>
        <field name="description">Acceso al monitoreo de la instancia</field>
        <field name="sequence">25</field>
    </record>

    <!-- Privilegio (Odoo 19 reemplaza category_id por privilege_id en res.groups) -->
    <record id="res_groups_privilege_pdev_monitoring" model="res.groups.privilege">
        <field name="name">Monitoreo de instancia</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_pdev_monitoring"/>
    </record>

    <record id="group_pdev_instance_monitoring_user" model="res.groups">
        <field name="name">Usuario de monitoreo</field>
        <field name="privilege_id" ref="res_groups_privilege_pdev_monitoring"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_pdev_instance_monitoring_manager" model="res.groups">
        <field name="name">Administrador de monitoreo</field>
        <field name="privilege_id" ref="res_groups_privilege_pdev_monitoring"/>
        <field name="implied_ids" eval="[(4, ref('group_pdev_instance_monitoring_user'))]"/>
    </record>
</odoo>
