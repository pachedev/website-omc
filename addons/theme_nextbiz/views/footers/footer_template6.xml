<odoo>
	<template id="theme_common_footer6" inherit_id="website.layout" name="Footer Six" active="False">
		<xpath expr="//div[@id='footer']" position="replace">
			<div id="footer" class="oe_structure oe_structure_solo" t-ignore="true"
				t-if="not no_footer">
				<section id="footer_theme_common6" class="footer_theme_common6 o_footer">
					<section class="footer-newsletter-section">
						<div class="container-fluid">
							<div class="row">
								<div class="newsletter-wrap">
									<div class="newsletter-content d-flex align-items-center w-100">
										<div class="oe_structure" />
										<div class="social-share ms-auto">
											<a href="/website/social/facebook"
												class="link"
												target="_blank"
												aria-label="Facebook text-reset">
												<i
													class="fa fa-facebook text-reset" />
											</a>
											<a href="/website/social/twitter"
												class="link" target="_blank"
												aria-label="X">
												<i
													class="fa fa-twitter text-reset" />
											</a>
											<a href="/website/social/linkedin"
												class="link me-3" target="_blank"
												aria-label="LinkedIn text-reset">
												<i
													class="fa fa-linkedin text-reset" />
											</a>
											<a href="/website/social/youtube"
												class="link" target="_blank"
												aria-label="YouTube">
												<i class="fa fa-youtube-play text-reset" />

											</a>
											<a href="/website/social/instagram"
												class="link" target="_blank"
												aria-label="Instagram">
												<i class="fa fa-instagram text-reset" />

											</a>
											<a href="/website/social/github"
												class="link" target="_blank"
												aria-label="GitHub">
												<i class="fa fa-github text-reset" />

											</a>
										</div>
									</div>
								</div>
							</div>
						</div>
					</section>
					<section class="footer-section">
						<div class="container">
							<div class="row justify-content-center pt64">
								<div class="col-md-4 mb-3">
									<div class="footer-links">
										<h6 class="title">CONTACT INFOMATION</h6>
									</div>
									<div class="contact-content">
										<p>Call Us 24/7 Free</p>
										<h2 class="text-reset">
											<span class="phone-number">
												<span> +1 (650)
													555-0111</span>
											</span>
										</h2>
										<p>
											<span>
												250 Executive Park Blvd,Suite 3400,
											</span>
											<br />
											<span>san
												francisco, 94314
											</span>
										</p>
									</div>
									<div class="footer-image d-flex mt16">
										<div class="image">
											<a href="#">
												<img
													src="/theme_nextbiz/static/src/img/footer-img1.png"
													data-original-src="/theme_nextbiz/static/src/img/footer-img1.png"
													class="img img-fluid" />
											</a>
										</div>
										<div class="image ms-2">
											<a href="#">
												<img
													src="/theme_nextbiz/static/src/img/footer-img2.png"
													data-original-src="/theme_nextbiz/static/src/img/footer-img2.png"
													class="img img-fluid" />
											</a>
										</div>
									</div>
								</div>
								<div class="col-md-2 mb-3">
									<div class="footer-links">
										<h6 class="title">COMPANY</h6>
										<p>
											<a href="#">Social Media</a>
										</p>
										<p>
											<a href="#">Brand Strategy</a>
										</p>
										<p>
											<a href="#">SEO Analysis</a>
										</p>
										<p>
											<a href="#">Promotion</a>
										</p>
									</div>
								</div>
								<div class="col-md-2 mb-3">
									<div class="footer-links">
										<h6 class="title">EXPLORE</h6>
										<p>
											<a href="#">Home</a>
										</p>
										<p>
											<a href="#">Contact Us</a>
										</p>
										<p>
											<a href="#">About Us</a>
										</p>
										<p>
											<a href="#">Policy</a>
										</p>
										<p>
											<a href="#">Computers</a>
										</p>
										<p>
											<a href="#">Speakers</a>
										</p>
									</div>
								</div>
								<div class="col-md-4 mb-3">
									<div class="footer-links">
										<h6 class="title">OUR LOCATION</h6>
									</div>
									<div class="footer-image">
										<div class="image">
											<a href="#">
												<img
													src="/theme_nextbiz/static/src/img/footer-img3.png"
													data-original-src="/theme_nextbiz/static/src/img/footer-img3.png"
													class="img img-fluid" />
											</a>
										</div>
									</div>

									<div class="footer-language">
										<div
											class="d-flex menu-language js_language_selector mb0 text-lg-center"
											t-if="((request and request.is_frontend_multilang and (languages and len(languages) > 1)) or (website and (editable or translatable)))">
											<p class="mb-0 me-2">
												<t t-foreach="website.language_ids" t-as="lg">
													<t
														t-if="request.env.context.get('lang') == lg.code">
														<img t-attf-src="{{lg.flag_image_url}}"
															width="18" t-att-title="lg.name"
															t-att-class="lg.code" />
													</t>
												</t>
											</p>
											<div class="dropdown">
												<a href="#"
													class="p-0 nav-link dropdown-toggle"
													type="button" data-bs-toggle="dropdown"
													aria-haspopup="true" aria-expanded="true">
													<t t-foreach="website.language_ids" t-as="lg">
														<t
															t-if="request.env.context.get('lang') == lg.code">
															<span
																class="lang_local_code text-uppercase"
																t-out="lg.name" />
														</t>
													</t>
												</a>
												<div class="dropdown-menu" role="menu">
													<t t-foreach="frontend_languages.values()"
														t-as="lg">
														<a
															t-att-href="url_localized(request.httprequest.path + '?' + keep_query(), lang_code=lg.code)"
															class="dropdown-item js_change_lang"
															t-att-data-url_code="lg.url_code">
															<t t-out="lg.name.split('/').pop()" />
														</a>
													</t>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						</div>
					</section>
				</section>
			</div>
		</xpath>
		<xpath expr="//div[hasclass('o_footer_copyright')]" position="replace">
			<div t-if="not no_copyright" class="o_footer_copyright">
				<div class="container">
					<section class="copyright-section py-4">
						<div class="container">
							<div class="row align-items-center">
								<div class="col-md-7 mb-4 mb-md-0 company">
									<span>© <span id="current-year">2025</span> All rights reserved.</span>
                                    <span t-field="res_company.name"/>
								</div>
								<div class="col-md-5">
									<div class="payment-image text-md-end">
										<img src="/theme_nextbiz/static/src/img/payment-footer.png"
											data-original-src="/theme_nextbiz/static/src/img/payment-footer.png"
											class="img-fluid" />
									</div>
								</div>
							</div>
						</div>
					</section>
				</div>
			</div>
		</xpath>
	</template>
</odoo>