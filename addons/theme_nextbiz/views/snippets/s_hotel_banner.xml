            <section class="s_carousel_wrapper s_carousel_wrapper_banner" data-vxml="001"
                data-vcss="001"
                data-snippet="s_carousel">
                <div class="s_carousel s_carousel_default carousel slide" data-pause="hover" data-bs-interval="7000" data-bs-ride="true" id="Hotelcarousel2" style="background-image: none;">
                 
                    <div class="carousel-inner" >

                        <div class="carousel-item active pt256 pb256" style="background-image: url('/theme_nextbiz/static/src/img/hotel-banner1.jpg');">
                            <div class="container">
                                <div class="banner-content text-center">
                                    <span>
                                        <img src="/theme_nextbiz/static/src/img/hotel-flower.png" data-original-src="/theme_nextbiz/static/src/img/hotel-flower.png" class="img img-fluid"/>
                                    </span>
                                    <h2 class="text-white">Vouge Hotel &amp; Resort</h2>
                                    <p>The Luxurious Hotel &amp; Resort Reservation</p>
                                    <div class="s_btn" data-name="Button">
                                        <a href="#" class="btn btn-outline-light btn-lg">Book Now Your Room</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item pt256 pb256" style="background-image: url('/theme_nextbiz/static/src/img/hotel-banner2.jpg');">
                            <div class="container">
                                <div class="banner-content text-center">
                                    <span>
                                        <img src="/theme_nextbiz/static/src/img/hotel-flower.png" data-original-src="/theme_nextbiz/static/src/img/hotel-flower.png" class="img img-fluid"/>
                                    </span>
                                    <h2 class="text-white">Vouge Hotel &amp; Resort</h2>
                                    <p>The Luxurious Hotel &amp; Resort Reservation</p>
                                    <div class="s_btn" data-name="Button">
                                        <a href="#" class="btn btn-outline-light btn-lg">Book Now Your Room</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="carousel-item pt256 pb256" style="background-image: url('/theme_nextbiz/static/src/img/hotel-banner3.jpg');">
                            <div class="container">
                                <div class="banner-content text-center">
                                    <span>
                                        <img src="/theme_nextbiz/static/src/img/hotel-flower.png" data-original-src="/theme_nextbiz/static/src/img/hotel-flower.png" class="img img-fluid"/>
                                    </span>
                                    <h2 class="text-white">Vouge Hotel &amp; Resort</h2>
