<odoo>
	<template id="s_app_landing_two_newsletter" name="Newsletter">
		<section class="app2-newsletter"  style="background-image: url('/theme_nextbiz/static/src/img/app-gradient-bg.png');">
			<div class="container">
				<div class="row">
					<div class="col-lg-6 col-md-6">
						<h4>Subscribe for latest email</h4>
					</div>
					<div class="col-lg-6 col-md-6">
						<div class="app-subscribe">
							<form class="s_newsletter_subscribe_form s_newsletter_list js_subscribe" data-vxml="001" data-list-id="1">
								<div class="js_subscribed_wrap d-none">
									<p class="h4-fs text-center text-success js_subscribed_btn"><i class="fa fa-check-circle-o" role="img"/>Thanks for registering!</p>
								</div>
								<div class="js_subscribe_wrap">
									<div class="input-group">
										<input type="email" name="email" class="js_subscribe_value form-control" placeholder="Enter Your Email"/>
										<span class="input-group-append">
											<button role="button" class="btn btn-primary js_subscribe_btn h-100 o_submit">Subscribe</button>
										</span>
									</div>
								</div>
							</form>
						</div>
					</div>
				</div>
			</div>
		</section>
	</template>
</odoo>