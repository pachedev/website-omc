    <t t-inherit-mode="extension" t-inherit="website.TopMenuVisibilityOption">
        <xpath expr="//BuilderRow[@label.translate='Text Color']" position="after">
            <BuilderRow label.translate="Text" level="1">
                <BuilderColorPicker
                    enabledTabs="['solid', 'custom']"
                    styleAction="'color'"
                    action="'setPageWebsiteDirty'"
                />
            </BuilderRow>
        </xpath>
    </t>

