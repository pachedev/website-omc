                    class="'m-auto py-1'"
                    src="'/theme_nextbiz/static/description/header6.png'"
                />
            </BuilderSelectItem>
        </xpath>
    </t>
    <t t-inherit="website.FooterTemplateOption" t-inherit-mode="extension">
