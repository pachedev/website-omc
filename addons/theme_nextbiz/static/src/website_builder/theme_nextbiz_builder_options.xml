<templates xml:space="preserve">
    <t t-inherit-mode="extension" t-inherit="website.HeaderTemplateOption">
        <xpath expr="//BuilderRow[@label.translate='Scroll Effect']" position="after">
            <BuilderRow label.translate="⌙ Width" t-if="isActiveItem('nextbiz_header_new3')">
                <BuilderNumberInput
                    action="'customizeWebsiteVariable'"
                    actionParam="'sidebar-width'"
                    unit="'px'"
                    saveUnit="'rem'"
                />
            </BuilderRow>
        </xpath>
        <xpath expr="//BuilderRow[@label.translate=&quot;Template&quot;]/BuilderSelect" position="inside">
            <BuilderSelectItem
                id="'nextbiz_header_new1'"
                title.translate="NextBiz Header 1"
                actionParam="[
                            {
                                action: 'websiteConfig',
                                actionParam: {
                                    views: ['theme_nextbiz.theme_nextbiz_header_new1'],
                                    vars: { 'header-template': 'nextbiz-header-1' },
                                    checkVars: false
                                }
                            }
                        ]">
                            <Img
                    attrs="{ style: 'width: calc(100% - 0.5rem); max-width:226px;' }"
                    class="'m-auto py-1'"
                    src="'/theme_nextbiz/static/description/header1.png'"
                />
            </BuilderSelectItem>
            <BuilderSelectItem
                id="'nextbiz_header_new2'"
                title.translate="NextBiz Header 2"
                actionParam="[
                            {
                                action: 'websiteConfig',
                                actionParam: {
                                    views: ['theme_nextbiz.theme_nextbiz_header_new2'],
                                    vars: { 'header-template': 'nextbiz-header-2' },
                                    checkVars: false
                                }
                            }
                        ]">
                            <Img
                    attrs="{ style: 'width: calc(100% - 0.5rem); max-width:226px;' }"
                    class="'m-auto py-1'"
                    src="'/theme_nextbiz/static/description/header2.png'"
                />
            </BuilderSelectItem>

            <BuilderSelectItem
                id="'nextbiz_header_new3'"
                title.translate="NextBiz Header 3"
                actionParam="[
                            {
                                action: 'websiteConfig',
                                actionParam: {
                                    views: ['theme_nextbiz.theme_nextbiz_header_new3', 'website.no_autohide_menu'],
                                    vars: { 'header-template': 'sidebar' },
                                    checkVars: false
                                }
                            }
                        ]">
                            <Img
                    attrs="{ style: 'width: calc(100% - 0.5rem); max-width:226px;' }"
                    class="'m-auto py-1'"
                    src="'/theme_nextbiz/static/description/header3.png'"
                />
