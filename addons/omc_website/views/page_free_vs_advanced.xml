<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_free_vs_advanced" model="ir.ui.view">
        <field name="name">OMC Free vs Advanced</field>
        <field name="type">qweb</field>
        <field name="key">omc_website.free_vs_advanced</field>
        <field name="arch" type="xml">
            <t t-name="omc_website.free_vs_advanced">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">

                        <section class="omc-hero pt56 pb56">
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 col-lg-8">
                                        <h1 class="mb-3">Free vs Advanced</h1>
                                        <p class="lead mb-0">Free covers everyday mobile access to your Odoo, with up to two saved servers. Advanced turns the app into your company's own: unlimited servers, your branding, push notifications and scanners.</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Comparison -->
                        <section class="o_cc o_cc1 pt56 pb40">
                            <div class="container">
                                <span class="omc-badge mb-3">Comparison</span>
                                <div class="row mb-5">
                                    <div class="col-12 col-lg-7">
                                        <h2 class="mb-0">What each edition gives you</h2>
                                    </div>
                                    <div class="col-12 col-lg-5">
                                        <p class="mb-0 mt-2 mt-lg-1">Same app experience; Advanced adds the company layer.</p>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped align-middle omc-compare">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="w-50">Feature</th>
                                                <th scope="col" class="text-center">Free</th>
                                                <th scope="col" class="text-center">Advanced</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Native app for all your Odoo apps</td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Sign in with your Odoo account</td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Fingerprint or face unlock</td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr class="fw-semibold">
                                                <td>Saved servers</td>
                                                <td class="text-center">2</td>
                                                <td class="text-center">Unlimited</td>
                                            </tr>
                                            <tr>
                                                <td>Push notifications for activities and messages</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>In-app branding: your colors, logo and company name</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>QR onboarding for your team</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Barcode scanner</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Document scanner</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Connected device management</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Supported Odoo versions</td>
                                                <td class="text-center">12 to 19+</td>
                                                <td class="text-center">17 to 19+</td>
                                            </tr>
                                            <tr>
                                                <td>Server module (Odoo App Store)</td>
                                                <td class="text-center">odoo_mobile_client (free)</td>
                                                <td class="text-center">odoo_mobile_client_advanced (one-time purchase)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="small text-muted mb-0">Free and Advanced are two separate apps — install the one that matches the module on your server: <a href="https://apps.odoo.com/apps/modules/19.0/odoo_mobile_client" target="_blank" rel="noopener">odoo_mobile_client</a> for Free, <a href="https://apps.odoo.com/apps/modules/19.0/odoo_mobile_client_advanced" target="_blank" rel="noopener">odoo_mobile_client_advanced</a> for Advanced, which installs the base module for you.</p>
                            </div>
                        </section>

                        <!-- What Advanced unlocks -->
                        <section class="o_cc o_cc2 pt56 pb56">
                            <div class="container">
                                <span class="omc-badge mb-3">What Advanced unlocks</span>
                                <div class="row mb-5">
                                    <div class="col-12 col-lg-7">
                                        <h2 class="mb-0">Make it your company's app</h2>
                                    </div>
                                    <div class="col-12 col-lg-5">
                                        <p class="mb-0 mt-2 mt-lg-1">One purchase, no subscription — your team gets a mobile app that looks and behaves like yours.</p>
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <div class="omc-card h-100 p-4">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-paint-brush"/></span>
                                            <h5>Your look inside the app</h5>
                                            <p class="mb-0">Your colors across the app, and your logo and company name in the side menu, plus your own welcome screen — all managed from Odoo. The store icon and app name stay as published.</p>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <div class="omc-card h-100 p-4">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-bell"/></span>
                                            <h5>Push notifications</h5>
                                            <p class="mb-0">Activities and messages reach your people on their phone, so nothing waits until someone opens a laptop.</p>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <div class="omc-card h-100 p-4">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-camera"/></span>
                                            <h5>Scanners built in</h5>
                                            <p class="mb-0">Barcode and document scanning straight from the camera — useful anywhere stock or paperwork moves.</p>
                                        </div>
                                    </div>
                                    <div class="col-12 col-md-6 col-lg-3">
                                        <div class="omc-card h-100 p-4">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-shield"/></span>
                                            <h5>Easy rollout</h5>
                                            <p class="mb-0">Each person signs in by scanning a QR code, and you keep an eye on the connected devices from Odoo.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Which one -->
                        <section class="o_cc o_cc1 pt56 pb40">
                            <div class="container">
                                <span class="omc-badge mb-3">Which one</span>
                                <div class="row mb-5">
                                    <div class="col-12 col-lg-7">
                                        <h2 class="mb-0">Pick the edition that fits your team</h2>
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-12 col-lg-6">
                                        <div class="omc-card h-100 p-4 p-lg-5">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-mobile"/></span>
                                            <h4>Choose Free if…</h4>
                                            <ul class="list-unstyled mb-0">
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You mainly need to consult and update Odoo on the move</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>Two saved servers are enough for you</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You run any Odoo from 12 to 19+</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You want to start today at no cost</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6">
                                        <div class="omc-card omc-card-accent h-100 p-4 p-lg-5">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-building"/></span>
                                            <h4>Choose Advanced if…</h4>
                                            <ul class="list-unstyled mb-0">
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You are rolling out Odoo to a whole team</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You need more than two servers, or your own branding</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You want your people notified on their phone</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>Scanning barcodes or documents is part of the job</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- CTA -->
                        <section class="pt40 pb56">
                            <div class="container">
                                <div class="o_cc o_cc3 omc-band p-4 p-lg-5">
                                    <div class="row align-items-center">
                                        <div class="col-12 col-lg-8">
                                            <h3 class="mb-1">Try both before you decide</h3>
                                            <p class="mb-0">Both editions are on Google Play and connect to our demo server, so you can see branding, notifications and scanners at work before buying anything.</p>
                                        </div>
                                        <div class="col-12 col-lg-4 text-lg-end mt-4 mt-lg-0">
                                            <a href="/download" class="btn btn-primary">Go to downloads</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="page_free_vs_advanced" model="website.page">
        <field name="name">Free vs Advanced</field>
        <field name="url">/free-vs-advanced</field>
        <field name="view_id" ref="view_free_vs_advanced"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">Free vs Advanced — Feature comparison | Odoo Mobile Client</field>
        <field name="website_meta_description">Free gives mobile access to Odoo with up to 2 saved servers. Advanced adds unlimited servers, company branding, push notifications, QR onboarding and scanners.</field>
    </record>

</odoo>
