<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_free_vs_advanced" model="ir.ui.view">
        <field name="name">OMC Free vs Advanced</field>
        <field name="type">qweb</field>
        <field name="key">omc_website.free_vs_advanced</field>
        <field name="arch" type="xml">
            <t t-name="omc_website.free_vs_advanced">
                <t t-call="website.layout">
                    <div id="wrap" class="oe_structure oe_empty">

                        <section class="omc-hero pt56 pb56">
                            <div class="container">
                                <div class="row">
                                    <div class="col-12 col-lg-8">
                                        <h1 class="mb-3">Free vs Advanced</h1>
                                        <p class="lead mb-0">Start with the free app today. Move to Advanced when you want your Odoo to reach out to you — not the other way around. Both are available now.</p>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- Comparison -->
                        <section class="o_cc o_cc1 pt56 pb40">
                            <div class="container">
                                <span class="omc-badge mb-3">Comparison</span>
                                <div class="row mb-5">
                                    <div class="col-12 col-lg-7">
                                        <h2 class="mb-0">What each edition gives you</h2>
                                    </div>
                                    <div class="col-12 col-lg-5">
                                        <p class="mb-0 mt-2 mt-lg-1">Same app experience; Advanced adds the notification layer.</p>
                                    </div>
                                </div>
                                <div class="table-responsive">
                                    <table class="table table-striped align-middle omc-compare">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="w-50">Feature</th>
                                                <th scope="col" class="text-center">Free</th>
                                                <th scope="col" class="text-center">Advanced</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Mobile access to all your Odoo apps</td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Native sign-in with your Odoo account</td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Multiple servers and environments</td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Fingerprint or face unlock</td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Push notifications on your phone</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Automatic alerts for sales, purchases, inventory, accounting and HR</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Open the exact record straight from a notification</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Notification rules you configure yourself</td>
                                                <td class="text-center"><span class="fa fa-minus text-muted" title="Not included"/></td>
                                                <td class="text-center"><span class="fa fa-check text-success" title="Included"/></td>
                                            </tr>
                                            <tr>
                                                <td>Supported Odoo versions</td>
                                                <td class="text-center">12 to 19+</td>
                                                <td class="text-center">17 to 19+</td>
                                            </tr>
                                            <tr>
                                                <td>Server module (Odoo App Store)</td>
                                                <td class="text-center">odoo_mobile_client (free)</td>
                                                <td class="text-center">odoo_mobile_client_advanced (paid)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                                <p class="small text-muted mb-0">Free and Advanced are two separate apps — install the one that matches the module on your server: <a href="https://apps.odoo.com/apps/modules/19.0/odoo_mobile_client" target="_blank" rel="noopener">odoo_mobile_client</a> for Free, <a href="https://apps.odoo.com/apps/modules/19.0/odoo_mobile_client_advanced" target="_blank" rel="noopener">odoo_mobile_client_advanced</a> for Advanced.</p>
                            </div>
                        </section>

                        <!-- Which one -->
                        <section class="o_cc o_cc2 pt56 pb56">
                            <div class="container">
                                <span class="omc-badge mb-3">Which one</span>
                                <div class="row mb-5">
                                    <div class="col-12 col-lg-7">
                                        <h2 class="mb-0">Pick the edition that fits your team</h2>
                                    </div>
                                </div>
                                <div class="row g-4">
                                    <div class="col-12 col-lg-6">
                                        <div class="omc-card h-100 p-4 p-lg-5">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-mobile"/></span>
                                            <h4>Choose Free if…</h4>
                                            <ul class="list-unstyled mb-0">
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>Your team mainly needs to consult and update Odoo on the move</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You run any Odoo from 12 to 19+</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You want to start today at no cost</li>
                                            </ul>
                                        </div>
                                    </div>
                                    <div class="col-12 col-lg-6">
                                        <div class="omc-card omc-card-accent h-100 p-4 p-lg-5">
                                            <span class="omc-icon-box mb-3"><i class="fa fa-bell"/></span>
                                            <h4>Choose Advanced if…</h4>
                                            <ul class="list-unstyled mb-0">
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You want your team notified the moment something happens in Odoo</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You run Odoo 17 to 19+</li>
                                                <li class="mb-2"><i class="fa fa-check text-primary me-2"/>You are ready to license the Advanced server module</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        <!-- CTA -->
                        <section class="pt40 pb56">
                            <div class="container">
                                <div class="o_cc o_cc3 omc-band p-4 p-lg-5">
                                    <div class="row align-items-center">
                                        <div class="col-12 col-lg-8">
                                            <h3 class="mb-1">Get started with Free today</h3>
                                            <p class="mb-0">Both editions are on Google Play. Try them with our demo server before connecting yours.</p>
                                        </div>
                                        <div class="col-12 col-lg-4 text-lg-end mt-4 mt-lg-0">
                                            <a href="/download" class="btn btn-primary">Go to downloads</a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </section>

                    </div>
                </t>
            </t>
        </field>
    </record>

    <record id="page_free_vs_advanced" model="website.page">
        <field name="name">Free vs Advanced</field>
        <field name="url">/free-vs-advanced</field>
        <field name="view_id" ref="view_free_vs_advanced"/>
        <field name="is_published" eval="True"/>
        <field name="website_indexed" eval="True"/>
        <field name="website_meta_title">Free vs Advanced — Feature comparison | Odoo Mobile Client</field>
        <field name="website_meta_description">Compare Odoo Mobile Client Free and Advanced: mobile access to Odoo is free; Advanced adds push notifications and automatic business alerts.</field>
    </record>

</odoo>
