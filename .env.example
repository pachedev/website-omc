# =============================================================================
# odoo-mobile-client [prod] - environment variables
#
# Template for the .env file. Copy it to .env and fill in the real values.
# .env is never committed: it holds secrets and machine-specific paths.
# =============================================================================

# ==========================================
# PROJECT
# ==========================================
PROJECT_NAME=odoo-mobile-client
ENVIRONMENT=prod
ODOO_VERSION=19

# ==========================================
# DATABASE
# ==========================================
DB_HOST=postgres-runtime
DB_PORT=1920
DB_USER=odoo
DB_PASSWORD=changeme
DB_NAME=omc_v19_prod

# ==========================================
# ODOO
# Master password of the database manager.
# ==========================================
ODOO_ADMIN_PASSWD=changeme

# ==========================================
# PORTS
# Reached through the reverse proxy, not published to the host.
# Each instance needs unique ports to avoid collisions, and the same values
# must be set on the reverse proxy entry.
# ==========================================
ODOO_PORT=8101
CHAT_PORT=8201

# ==========================================
# HOST DATA PATHS
#
# Paths on the HOST that get mounted into the container. The paths INSIDE the
# container are fixed and never change:
#     HOST_FILESTORE_PATH -> /var/lib/odoo/filestore
#     HOST_SESSIONS_PATH  -> /var/lib/odoo/sessions
#     HOST_PGDATA_PATH    -> /var/lib/postgresql/data  (dedicated PostgreSQL only)
#
# They are specific to each machine, which is why they live here and not in
# docker-compose.yml, which is committed. Must be ABSOLUTE paths.
#
# Any location works - a separate disk for the filestore, for example.
# ==========================================
HOST_FILESTORE_PATH=/opt/platform/shared/filestore/prod/odoo-mobile-client
HOST_SESSIONS_PATH=/opt/platform/shared/sessions/prod/odoo-mobile-client
# HOST_PGDATA_PATH=/opt/platform/shared/postgres/prod/odoo-mobile-client
